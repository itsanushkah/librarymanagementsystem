# Copy to .env and fill in. Use LMS_DB_BACKEND=sqlite to run without MySQL.
LMS_DB_BACKEND=mysql
LMS_MYSQL_HOST=localhost
LMS_MYSQL_PORT=3306
LMS_MYSQL_USER=root
LMS_MYSQL_PASSWORD=
LMS_MYSQL_DATABASE=library
LMS_SQLITE_PATH=library.db

# Lending rules
LMS_LOAN_DAYS=14
LMS_MAX_ACTIVE_LOANS=3
LMS_FINE_PER_DAY=5
