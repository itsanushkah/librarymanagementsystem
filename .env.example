# Copy to .env and fill in.
# Database: mysql (default), postgres, or sqlite (no setup needed).
LMS_DB_BACKEND=mysql
LMS_MYSQL_HOST=localhost
LMS_MYSQL_PORT=3306
LMS_MYSQL_USER=root
LMS_MYSQL_PASSWORD=
LMS_MYSQL_DATABASE=library
LMS_SQLITE_PATH=library.db
# A postgres:// URL overrides the settings above (Render sets this for you).
# DATABASE_URL=postgresql://user:password@localhost/library

# Web app
SECRET_KEY=
LMS_ADMIN_USERNAME=admin
LMS_ADMIN_PASSWORD=change-me
# Load sample books, members and loans when the library is empty
LMS_SEED_DEMO_DATA=0

# Lending rules
LMS_LOAN_DAYS=14
LMS_MAX_ACTIVE_LOANS=3
LMS_FINE_PER_DAY=5
LMS_MAX_UNPAID_FINES=50
LMS_MAX_RESERVATIONS=3
LMS_HOLD_DAYS=3
